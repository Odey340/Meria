NVIDIA_API_KEY=nvapi-...            # https://build.nvidia.com
NEMOTRON_SUPER=                      # paste the exact model ID from build.nvidia.com
NEMOTRON_NANO=
GAUNTLET_MODE=live                   # live | cached | mock
LEGACY_PLUGIN=                       # /usr/lib/nagios/plugins/check_snmp on the demo machine
GAUNTLET_GITHUB_REPO=                # owner/repo to open real work orders as issues (needs gh auth)
